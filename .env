# ── Application ──────────────────────────────────────────────────────
NEXUSDL_APP__NAME=NexusDL
NEXUSDL_PUBLIC_URL=https://nexus-webtoon-download.com
NEXUSDL_API_BASE_URL=https://nexus-webtoon-download.com
NEXUSDL_FRONTEND_URL=https://nexus-webtoon-download.com

# ── Secrets (générés par bootstrap_env_file) ─────────────────────────
NEXUSDL_SECRET_KEY=0952258a50dbb0cbc1aa5a091b7956f207faf59c0726f58a4a0b70377103d0ba
NEXUSDL_JWT_SECRET=8e7002460e7f1502a2654c5e6cfc9751bee723407e828f1983a321fc04fbedc3
NEXUSDL_COOKIE_ENCRYPTION_KEY=d5Dm2DQnuwpwlE4itHyL0RIoJvhv4Ul_euJY0P07jqA=

# ── API ──────────────────────────────────────────────────────────────
NEXUSDL_API__JWT_ALGORITHM=HS256
NEXUSDL_API__JWT_EXPIRE_MINUTES=60
NEXUSDL_API__CORS_ORIGINS=["https://nexus-webtoon-download.com"]

# ── Contenu ──────────────────────────────────────────────────────────
NEXUSDL_CONTENT__ALLOW_ADULT=true

# ── Downloader ───────────────────────────────────────────────────────
NEXUSDL_DOWNLOADER__MAX_CONCURRENT_TASKS=3
NEXUSDL_DOWNLOADER__MAX_CONCURRENT_PAGES=8
NEXUSDL_DOWNLOADER__RETRY__MAX_ATTEMPTS=3

# ── HTTP ─────────────────────────────────────────────────────────────
NEXUSDL_HTTP__READ_TIMEOUT=30
NEXUSDL_HTTP__CONNECT_TIMEOUT=10

# ── Rate limits ──────────────────────────────────────────────────────
NEXUSDL_RATE_LIMITS__DEFAULT_PER_SECOND=2.0

# ── Compliance ───────────────────────────────────────────────────────
NEXUSDL_COMPLIANCE__RESPECT_ROBOTS_TXT=true

# ── Logging ──────────────────────────────────────────────────────────
NEXUSDL_LOGGING__LEVEL=INFO
NEXUSDL_LOGGING__FORMAT=json
NEXUSDL_LOGGING__ROTATION="10 MB"
NEXUSDL_LOGGING__RETENTION="30 days"

# ── Playwright (désactivé par défaut) ────────────────────────────────
NEXUSDL_PLAYWRIGHT__ENABLED=false
NEXUSDL_PLAYWRIGHT__HEADLESS=true
NEXUSDL_PLAYWRIGHT__MAX_CONTEXTS=4

# ── FlareSolverr (désactivé par défaut) ──────────────────────────────
NEXUSDL_FLARESOLVERR__TIMEOUT_MS=60000

# ── SUPPRIMÉS (pas de champ dans Settings) ───────────────────────────
# NEXUSDL_APP_ENVIRONMENT
# NEXUSDL_DATABASE_ECHO
# NEXUSDL_API_RATE_LIMIT_PER_MINUTE
# NEXUSDL_JWT_ALGORITHM (migré vers NEXUSDL_API__JWT_ALGORITHM)
# NEXUSDL_JWT_EXPIRE_MINUTES (migré vers NEXUSDL_API__JWT_EXPIRE_MINUTES)
# NEXUSDL_HTTP_TIMEOUT_SECONDS (remplacé par NEXUSDL_HTTP__READ_TIMEOUT)
# NEXUSDL_HTTP_MAX_RETRIES (remplacé par NEXUSDL_DOWNLOADER__RETRY__MAX_ATTEMPTS)
# NEXUSDL_DEFAULT_RATE_LIMIT_PER_SECOND (remplacé par NEXUSDL_RATE_LIMITS__DEFAULT_PER_SECOND)
# NEXUSDL_MAX_CONCURRENT_DOWNLOADS (remplacé par NEXUSDL_DOWNLOADER__MAX_CONCURRENT_TASKS)
# NEXUSDL_MAX_CONCURRENT_PAGES_PER_CHAPTER (remplacé par NEXUSDL_DOWNLOADER__MAX_CONCURRENT_PAGES)
# NEXUSDL_PLAYWRIGHT_ENABLED (remplacé par NEXUSDL_PLAYWRIGHT__ENABLED)
# NEXUSDL_PLAYWRIGHT_HEADLESS (remplacé par NEXUSDL_PLAYWRIGHT__HEADLESS)
# NEXUSDL_PLAYWRIGHT_MAX_CONTEXTS (remplacé par NEXUSDL_PLAYWRIGHT__MAX_CONTEXTS)
# NEXUSDL_FLARESOLVERR_TIMEOUT_SECONDS (remplacé par NEXUSDL_FLARESOLVERR__TIMEOUT_MS)
# NEXUSDL_ALLOW_ADULT (remplacé par NEXUSDL_CONTENT__ALLOW_ADULT)
# NEXUSDL_LOG_LEVEL (remplacé par NEXUSDL_LOGGING__LEVEL)
# NEXUSDL_LOG_FORMAT (remplacé par NEXUSDL_LOGGING__FORMAT)
# NEXUSDL_LOG_ROTATION (remplacé par NEXUSDL_LOGGING__ROTATION)
# NEXUSDL_LOG_RETENTION (remplacé par NEXUSDL_LOGGING__RETENTION)
# NEXUSDL_API_CORS_ORIGINS (remplacé par NEXUSDL_API__CORS_ORIGINS)
# NEXUSDL_APP_NAME (remplacé par NEXUSDL_APP__NAME, ou supprimer — le défaut est déjà "NexusDL")
