# ════════════════════════════════════════════════════════════════════
# NexusDL — Environment variables (example)
#
# ════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════
# 1. APPLICATION
# ═══════════════════════════════════════════════════════════════════
# Nom affiché de l'application.
NEXUSDL_APP_NAME=NexusDL

# Version sémantique — surchargée par version.py au runtime.
NEXUSDL_APP_VERSION=0.1.0

# Environnement : dev | staging | prod
NEXUSDL_APP_ENVIRONMENT=dev

# URL publique du frontend (utilisée dans les emails, OG tags, CORS).
NEXUSDL_PUBLIC_URL=https://nexusdl.example.com

# URL publique de l'API REST (utilisée par le frontend).
NEXUSDL_API_BASE_URL=https://api.nexusdl.example.com

# URL du frontend Next.js (utilisée pour les redirections OAuth).
NEXUSDL_FRONTEND_URL=https://nexusdl.example.com


# ═══════════════════════════════════════════════════════════════════
# 2. SÉCURITÉ
# ═══════════════════════════════════════════════════════════════════
# Générer avec :
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# Chaque secret doit être UNIQUE et différent des autres.
# Ne jamais réutiliser le même secret pour SECRET_KEY et JWT_SECRET.

NEXUSDL_SECRET_KEY=CHANGE_ME_64_HEX_CHARS
NEXUSDL_JWT_SECRET=CHANGE_ME_64_HEX_CHARS
NEXUSDL_JWT_ALGORITHM=HS256
NEXUSDL_JWT_EXPIRE_MINUTES=60
NEXUSDL_COOKIE_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS


# ═══════════════════════════════════════════════════════════════════
# 3. BASE DE DONNÉES
# ═══════════════════════════════════════════════════════════════════
# SQLite async (défaut). Remplacer par postgresql+asyncpg://... si besoin.
NEXUSDL_DATABASE_URL=sqlite+aiosqlite:///./data/library.db
NEXUSDL_DATABASE_ECHO=false


# ═══════════════════════════════════════════════════════════════════
# 4. REDIS (optionnel — cache distribué)
# ═══════════════════════════════════════════════════════════════════
# Laisser commenté si non utilisé.
# NEXUSDL_REDIS_URL=redis://localhost:6379/0


# ═══════════════════════════════════════════════════════════════════
# 5. HTTP
# ═══════════════════════════════════════════════════════════════════
NEXUSDL_HTTP_TIMEOUT_SECONDS=30
NEXUSDL_HTTP_MAX_RETRIES=3

# User-Agent personnalisé — laisser vide pour le défaut NexusDL.
# NEXUSDL_HTTP_USER_AGENT=

# Vérifie robots.txt avant chaque requête. Désactiver = responsabilité utilisateur.
NEXUSDL_RESPECT_ROBOTS_TXT=true


# ═══════════════════════════════════════════════════════════════════
# 6. RATE LIMITS
# ═══════════════════════════════════════════════════════════════════
NEXUSDL_DEFAULT_RATE_LIMIT_PER_SECOND=2.0
NEXUSDL_MAX_CONCURRENT_DOWNLOADS=3
NEXUSDL_MAX_CONCURRENT_PAGES_PER_CHAPTER=8


# ═══════════════════════════════════════════════════════════════════
# 7. PLAYWRIGHT (sites JS / Cloudflare)
# ═══════════════════════════════════════════════════════════════════
# Nécessite : playwright install chromium
NEXUSDL_PLAYWRIGHT_ENABLED=false
NEXUSDL_PLAYWRIGHT_HEADLESS=true
NEXUSDL_PLAYWRIGHT_MAX_CONTEXTS=4


# ═══════════════════════════════════════════════════════════════════
# 8. FLARESOLVERR (optionnel — alternative à Playwright)
# ═══════════════════════════════════════════════════════════════════
# NEXUSDL_FLARESOLVERR_URL=http://localhost:8191/v1
NEXUSDL_FLARESOLVERR_TIMEOUT_SECONDS=60


# ═══════════════════════════════════════════════════════════════════
# 9. PROXIES (optionnel)
# ═══════════════════════════════════════════════════════════════════
# Proxy unique inline.
# NEXUSDL_PROXY_URL=http://user:pass@proxy.example.com:8080

# Fichier YAML contenant une liste de proxies (rotation automatique).
# NEXUSDL_PROXY_FILE=./config/proxy.yaml


# ═══════════════════════════════════════════════════════════════════
# 10. CONTENU
# ═══════════════════════════════════════════════════════════════════
# Active les sites et contenus adultes (18+). Responsabilité de l'utilisateur.
NEXUSDL_ALLOW_ADULT=false

# Autorise le contenu violent / gore (généralement non filtré par défaut).
NEXUSDL_ALLOW_VIOLENT=true

# Filtrage strict (whitelist genres) — désactivé par défaut.
NEXUSDL_CONTENT_FILTER_STRICT=false


# ═══════════════════════════════════════════════════════════════════
# 11. STOCKAGE
# ═══════════════════════════════════════════════════════════════════
# Chemins résolus via platformdirs si non définis :
#   Linux   : ~/.local/share/nexusdl/, ~/.local/state/nexusdl/
#   macOS   : ~/Library/Application Support/nexusdl/
#   Windows : %LOCALAPPDATA%\nexusdl\
#
# Décommenter UNIQUEMENT pour surcharger les chemins par défaut.

# NEXUSDL_DOWNLOAD_DIR=~/Downloads/NexusDL
# NEXUSDL_TEMP_DIR=/tmp/nexusdl
# NEXUSDL_LIBRARY_DB_PATH=~/.local/share/nexusdl/library.db
# NEXUSDL_COOKIE_STORAGE_PATH=~/.local/share/nexusdl/cookies.enc
# NEXUSDL_LOGS_DIR=~/.local/state/nexusdl/logs


# ═══════════════════════════════════════════════════════════════════
# 12. LOGGING
# ═══════════════════════════════════════════════════════════════════
# Niveaux : TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
NEXUSDL_LOG_LEVEL=INFO

# Formats : json (prod) | text | pretty (dev, coloré)
NEXUSDL_LOG_FORMAT=pretty

# Rotation : "10 MB", "1 day", "00:00"…
NEXUSDL_LOG_ROTATION=10 MB
NEXUSDL_LOG_RETENTION=30 days


# ═══════════════════════════════════════════════════════════════════
# 13. API REST
# ═══════════════════════════════════════════════════════════════════
# Origines autorisées (JSON array, obligatoire pour FastAPI CORS).
NEXUSDL_API_CORS_ORIGINS=["http://localhost:3000"]

# Rate limit global de l'API (requêtes par minute par IP).
NEXUSDL_API_RATE_LIMIT_PER_MINUTE=60


# ═══════════════════════════════════════════════════════════════════
# 14. CREDENTIALS SITES (optionnels — uniquement si le site en requiert)
# ═══════════════════════════════════════════════════════════════════
# Ces variables sont lues par les parsers correspondants.
# Laisser vides si non utilisés.

# ── nhentai.net ──
# NEXUSDL_NHENTAI_USERNAME=
# NEXUSDL_NHENTAI_PASSWORD=

# ── MangaDex (API officielle) ──
# NEXUSDL_MANGADEX_CLIENT_ID=
# NEXUSDL_MANGADEX_CLIENT_SECRET=

# ── Comick (API officielle) ──
# NEXUSDL_COMICK_API_KEY=
