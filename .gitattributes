# ════════════════════════════════════════════════════════════════════
# NexusDL — .gitattributes
#
# Contrôle :
#   - la normalisation des fins de ligne (LF/CRLF)
#   - la détection des fichiers binaires vs texte
#   - les stratégies de merge et de diff
#   - le linguist (statistiques GitHub)
#
# Spec : https://git-scm.com/docs/gitattributes
# Cohérent avec `.editorconfig` et la stratégie multi-plateforme
# (Linux / macOS / Windows / Docker).
# ════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────
# RÈGLE PAR DÉFAUT
# ────────────────────────────────────────────────────────────────────
# Normalise toutes les fins de ligne en LF dans le dépôt.
# Le checkout utilisera LF sauf exception explicite (voir sections
# Windows plus bas).
* text=auto eol=lf


# ────────────────────────────────────────────────────────────────────
# FICHIERS TEXTE — normalisation LF explicite
# ────────────────────────────────────────────────────────────────────
*.py       text eol=lf
*.pyi      text eol=lf
*.pyx      text eol=lf
*.pxd      text eol=lf

*.toml     text eol=lf
*.cfg      text eol=lf
*.ini      text eol=lf
*.conf     text eol=lf
*.properties text eol=lf

*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.jsonc    text eol=lf
*.lock     text eol=lf
*.dl       text eol=lf

*.md       text eol=lf
*.mdx      text eol=lf
*.rst      text eol=lf
*.txt      text eol=lf

*.js       text eol=lf
*.jsx      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.sass     text eol=lf
*.less     text eol=lf
*.tcss     text eol=lf

*.html     text eol=lf
*.htm      text eol=lf
*.jinja    text eol=lf
*.jinja2   text eol=lf
*.j2       text eol=lf
*.xml      text eol=lf
*.svg      text eol=lf

*.sh       text eol=lf
*.bash     text eol=lf
*.zsh      text eol=lf
*.sql      text eol=lf

Dockerfile           text eol=lf
Dockerfile.*         text eol=lf
*.dockerfile         text eol=lf
.dockerignore        text eol=lf
docker-compose.yml   text eol=lf
docker-compose.*.yml text eol=lf
nginx.conf           text eol=lf

Makefile             text eol=lf
makefile             text eol=lf
GNUmakefile          text eol=lf
*.mk                 text eol=lf
justfile             text eol=lf

.gitignore           text eol=lf
.gitattributes       text eol=lf
.editorconfig        text eol=lf
.pre-commit-config.yaml text eol=lf
.env.example         text eol=lf


# ────────────────────────────────────────────────────────────────────
# FICHIERS WINDOWS — CRLF obligatoire
# ────────────────────────────────────────────────────────────────────
*.ps1      text eol=crlf
*.psm1     text eol=crlf
*.psd1     text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf


