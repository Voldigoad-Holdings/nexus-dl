# ────────────────────────────────────────────────────────────────────
# LINGUIST — stats GitHub
# ────────────────────────────────────────────────────────────────────
# Le frontend Next.js est un sous-projet distinct : ne pas le compter
# dans les stats principales du repo Python.
src/nexusdl/interfaces/web/frontend/** linguist-vendored

# Les lockfiles et fichiers générés ne doivent pas polluer les stats.
uv.lock                          linguist-generated=true
pnpm-lock.yaml                   linguist-generated=true
package-lock.json                linguist-generated=true
yarn.lock                        linguist-generated=true
*.min.js                         linguist-generated=true
*.min.css                        linguist-generated=true

# Documentation : marquée comme doc.
docs/**                          linguist-documentation

# Tests : marqués comme test.
tests/**                         linguist-detectable=true


# ────────────────────────────────────────────────────────────────────
# STRATÉGIES DE MERGE & DIFF
# ────────────────────────────────────────────────────────────────────
# Lockfiles : ne JAMAIS auto-merger (conflits silencieux dangereux).
uv.lock                          merge=binary
pnpm-lock.yaml                   merge=binary
package-lock.json                merge=binary
yarn.lock                        merge=binary

# Migrations Alembic : merge manuel obligatoire.
src/nexusdl/core/library/migrations/*.sql merge=union

# Changelog : merge=union (concatène les ajouts des deux branches).
CHANGELOG.md                     merge=union

# Documentation de décisions : merge=union.
docs/source/development/decisions/*.md merge=union


# ────────────────────────────────────────────────────────────────────
# EXPORT-IGNORE — exclure du `git archive`
# ────────────────────────────────────────────────────────────────────
.github/                export-ignore
.dockerignore           export-ignore
.editorconfig           export-ignore
.gitattributes          export-ignore
.pre-commit-config.yaml export-ignore
.docker/                export-ignore
docker/                 export-ignore
tests/                  export-ignore
scripts/                export-ignore
assets/screenshots/     export-ignore
src/nexusdl/interfaces/web/frontend/node_modules/ export-ignore
src/nexusdl/interfaces/web/frontend/.next/        export-ignore
