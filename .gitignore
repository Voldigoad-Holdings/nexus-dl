# ════════════════════════════════════════════════════════════════════
# NexusDL — .gitignore
#
# Organisation :
#   1. Secrets et configuration locale
#   2. Python
#   3. Node.js / Next.js frontend
#   4. Données runtime NexusDL
#   5. Outils (ruff, mypy, pytest, coverage, hypothesis)
#   6. Build et distribution
#   7. Environnements virtuels
#   8. Docker
#   9. IDE et éditeurs
#  10. OS
#  11. Divers
#
# ⚠️  Rappel : un fichier ignoré n'est PAS versionné. Ne jamais retirer
#     les entrées "Secrets" sous aucun prétexte.
# ════════════════════════════════════════════════════════════════════


# ────────────────────────────────────────────────────────────────────
# 1. SECRETS ET CONFIGURATION LOCALE
# ────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.template

# Fichiers de configuration locaux (à créer à partir des .example)
config/config.yaml
config/proxy.yaml
config/sites_overrides.yaml
config/logging.local.yaml

# Clés, certificats, keystores
*.key
*.keyfile
*.pem
*.p12
*.pfx
secrets/
secrets.yaml
*.cookies
cookies.enc


# ────────────────────────────────────────────────────────────────────
# 2. PYTHON
# ────────────────────────────────────────────────────────────────────
# Bytecode et caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyd

# Environnements virtuels
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# Packaging et distribution
build/
dist/
develop-eggs/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
*.whl
pip-wheel-metadata/
share/python-wheels/
MANIFEST
.installed.cfg

# PyInstaller / Nuitka
*.manifest
*.spec
*.build/
*.dist/
*.onefile-build/
__pyinstaller/
pyinstaller/

# pyenv
.python-version


# ────────────────────────────────────────────────────────────────────
# 3. NODE.JS / NEXT.JS FRONTEND
# ────────────────────────────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
.vercel/
.npm/
.pnpm-store/
.yarn/
.eslintcache
.parcel-cache/
*.tsbuildinfo
next-env.d.ts

# Environnements frontend locaux
src/nexusdl/interfaces/web/frontend/.env.local
src/nexusdl/interfaces/web/frontend/.env.*.local

# Build frontend
src/nexusdl/interfaces/web/frontend/build/
src/nexusdl/interfaces/web/frontend/dist/


# ────────────────────────────────────────────────────────────────────
# 4. DONNÉES RUNTIME NEXUSDL
# ────────────────────────────────────────────────────────────────────
# Base de données locale
data/
!data/.gitkeep
library.db
library.db-*
library.db-journal
library.db-wal
library.db-shm
*.sqlite
*.sqlite3

# Dossiers de travail
downloads/
temp/
tmp/
logs/
*.log
*.log.*

# Caches runtime
.cache/
.nexusdl/


# ────────────────────────────────────────────────────────────────────
# 5. OUTILS (lint, type, tests, coverage)
# ────────────────────────────────────────────────────────────────────
# Ruff
.ruff_cache/

# Mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pytest
.pytest_cache/
pytestdebug.log

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# Hypothesis
.hypothesis/

# Tox / Nox
.tox/
.nox/

# Pre-commit
.pre-commit-cache/


# ────────────────────────────────────────────────────────────────────
# 6. BUILD ET DISTRIBUTION (non-Python)
# ────────────────────────────────────────────────────────────────────
# Sorties génériques
out/
output/
release/
releases/

# Fichiers d'archive générés localement
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.cbz
*.cb7
*.cbt
*.cbr
*.pdf

# Exceptions — les fixtures de test et le template ComicInfo
!tests/fixtures/*.zip
!tests/fixtures/*.cbz
!tests/fixtures/*.pdf
!src/nexusdl/data/comic_info_template.xml


# ────────────────────────────────────────────────────────────────────
# 7. DOCKER
# ────────────────────────────────────────────────────────────────────
.docker/
docker-compose.override.yml
docker-compose.*.local.yml


# ────────────────────────────────────────────────────────────────────
# 8. IDE ET ÉDITEURS
# ────────────────────────────────────────────────────────────────────
# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace

# JetBrains (PyCharm, IntelliJ, WebStorm)
.idea/
*.iml
*.ipr
*.iws

# Vim / Neovim
*.swp
*.swo
*.swn
*~
.[a-z]*

# Emacs
*~
\#*\#
.\#*

# Sublime
*.sublime-project
*.sublime-workspace

# Eclipse
.project
.classpath
.settings/
.factorypath

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Misc
*.suo
*.ntvs*
*.njsproj
*.sln
*.user
*.userosscache
*.sln.docstates


# ────────────────────────────────────────────────────────────────────
# 9. OS — FICHIERS SYSTÈME
# ────────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
ehthumbs_vista.db

# Windows
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux
.directory
.Trash-*
.fuse_hidden*
.nfs*


# ────────────────────────────────────────────────────────────────────
# 10. DIVERS
# ────────────────────────────────────────────────────────────────────
# Process IDs
*.pid
*.pid.lock
*.seed

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Fichiers temporaires
*.tmp
*.bak
*.orig
*.rej
*.swp
*.swo

# Fixtures générées
tests/.coverage
tests/fixtures/tmp/

# Jupyter
.ipynb_checkpoints/

# Fichiers de swap / lock d'outils
*.lock.tmp
.pnpm-debug.log


# ────────────────────────────────────────────────────────────────────
# 11. EXCEPTIONS NEXUSDL — fichiers à VERSIONNER explicitement
# ────────────────────────────────────────────────────────────────────
# Ces règles annulent les patterns génériques ci-dessus pour les
# fichiers qui DOIVENT être commités.

!.gitkeep
!src/nexusdl/data/*.yaml
!src/nexusdl/data/*.json
!src/nexusdl/data/*.xml
!src/nexusdl/data/*.txt
!src/nexusdl/data/translations/*.json
!src/nexusdl/py.typed
!src/nexusdl/version.py
!src/nexusdl/interfaces/web/frontend/pnpm-lock.yaml
!uv.lock
!nexus.dl
!LICENSE
!README.md
!CHANGELOG.md
!SECURITY.md
!SECURITY_HALL_OF_FAME.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
