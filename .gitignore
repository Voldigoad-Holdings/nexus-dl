# ════════════════════════════════════════════════════════════════════
# NexusDL — .gitignore
#
# Organisation :
#   1. Secrets et configuration locale
#   2. Python
#   3. Node.js / Next.js frontend
#   4. Données runtime NexusDL
#   5. Outils (ruff, mypy, pytest, coverage, hypothesis)
#   6. Build et distribution
#   7. Docker
#   8. IDE et éditeurs
#   9. OS
#  10. Divers
#
# ⚠️  Rappel : un fichier ignoré n'est PAS versionné. Ne jamais retirer
#     les entrées "Secrets" sous aucun prétexte.
#
# ⚠️  Règle d'or : toute nouvelle règle d'ignore qui matche un dossier
#     (``dir/``) doit être ancrée (``/dir/``) si ce dossier peut exister
#     sous ``src/nexusdl/`` — sinon elle masque des fichiers versionnés.
# ════════════════════════════════════════════════════════════════════


# ────────────────────────────────────────────────────────────────────
# 1. SECRETS ET CONFIGURATION LOCALE
# ────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.template

# Fichiers de configuration locaux (à créer à partir des .example)
config/config.yaml
config/proxy.yaml
config/sites_overrides.yaml
config/logging.local.yaml

# Clés, certificats, keystores
*.key
*.keyfile
*.pem
*.p12
*.pfx
secrets/
secrets.yaml
*.cookies
cookies.enc


# ────────────────────────────────────────────────────────────────────
# 2. PYTHON
# ────────────────────────────────────────────────────────────────────
# Bytecode et caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyd

# Environnements virtuels
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ⚠️  ``.python-version`` N'EST PAS ignoré — il est versionné pour
#     garantir que tous les développeurs utilisent Python 3.12.
#     (ne pas réintroduire cette ligne)

# Packaging et distribution
build/
dist/
develop-eggs/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
*.whl
pip-wheel-metadata/
share/python-wheels/
MANIFEST
.installed.cfg

# PyInstaller / Nuitka
*.spec
*.onefile-build/
__pyinstaller/
pyinstaller/


# ────────────────────────────────────────────────────────────────────
# 3. NODE.JS / NEXT.JS FRONTEND
# ────────────────────────────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
.vercel/
.npm/
.pnpm-store/
.yarn/
.eslintcache
.parcel-cache/
*.tsbuildinfo
next-env.d.ts


# ────────────────────────────────────────────────────────────────────
# 4. DONNÉES RUNTIME NEXUSDL
# ────────────────────────────────────────────────────────────────────
# ⚠️  ``/data/`` est ancré à la racine — il ne masque PAS
#     ``src/nexusdl/data/`` qui contient les fichiers versionnés
#     (sites.yaml, default_config.yaml, translations/*.json, etc.).
#     Un ``data/`` non ancré casserait le package.
/data/
library.db
library.db-*
library.db-journal
library.db-wal
library.db-shm
*.sqlite
*.sqlite3

# Dossiers de travail
/downloads/
/temp/
/tmp/
/logs/
*.log
*.log.*

# Caches runtime
/.cache/
/.nexusdl/


# ────────────────────────────────────────────────────────────────────
# 5. OUTILS (lint, type, tests, coverage)
# ────────────────────────────────────────────────────────────────────
# Ruff
.ruff_cache/

# Mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pytest
.pytest_cache/
pytestdebug.log

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# Hypothesis
.hypothesis/

# Tox / Nox
.tox/
.nox/


# ────────────────────────────────────────────────────────────────────
# 6. BUILD ET DISTRIBUTION (non-Python)
# ────────────────────────────────────────────────────────────────────
# Sorties génériques
output/
release/
releases/

# Fichiers d'archive générés localement
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.cbz
*.cb7
*.cbt
*.cbr
*.pdf

# Exceptions — fixtures de test (nécessaires au CI)
!tests/fixtures/*.zip
!tests/fixtures/*.cbz
!tests/fixtures/*.pdf


# ────────────────────────────────────────────────────────────────────
# 7. DOCKER
# ────────────────────────────────────────────────────────────────────
.docker/
docker-compose.override.yml
docker-compose.*.local.yml


# ────────────────────────────────────────────────────────────────────
# 8. IDE ET ÉDITEURS
# ────────────────────────────────────────────────────────────────────
# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace

# JetBrains (PyCharm, IntelliJ, WebStorm)
.idea/
*.iml
*.ipr
*.iws

# Vim / Neovim
*.swp
*.swo
*.swn
*~
.vimrc.local
.viminfo

# Emacs
*~
\#*\#
.\#*
.emacs.d/

# Sublime
*.sublime-project
*.sublime-workspace

# Eclipse
.project
.classpath
.settings/
.factorypath

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# Misc
*.suo
*.ntvs*
*.njsproj
*.sln
*.user
*.userosscache
*.sln.docstates


# ────────────────────────────────────────────────────────────────────
# 9. OS — FICHIERS SYSTÈME
# ────────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
ehthumbs_vista.db

# Windows
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux
.directory
.Trash-*
.fuse_hidden*
.nfs*


# ────────────────────────────────────────────────────────────────────
# 10. DIVERS
# ────────────────────────────────────────────────────────────────────
# Process IDs
*.pid
*.pid.lock
*.seed

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Fichiers temporaires
*.tmp
*.bak
*.orig
*.rej
*.swp
*.swo

# Fixtures générées
tests/.coverage
tests/fixtures/tmp/

# Jupyter
.ipynb_checkpoints/

# Fichiers de swap / lock d'outils
*.lock.tmp
.pnpm-debug.log


# ────────────────────────────────────────────────────────────────────
# 11. FICHIERS VERSIONNÉS EXPLICITEMENT (documentaire)
# ────────────────────────────────────────────────────────────────────
# Cette section liste les fichiers du projet qui DOIVENT être commités
# et qui pourraient l'être accidentellement ignorés par une règle
# générique ajoutée dans le futur.  Aucune règle active ne les ignore
# aujourd'hui — c'est une défense en profondeur contre les régressions.
#
# Si tu ajoutes une règle d'ignore générique (``*.md``, ``*.json``, …),
# vérifie qu'aucun de ces fichiers n'est affecté, et réactive-le ici si
# nécessaire.
#
# !uv.lock
# !nexus.dl
# !MANIFEST.in
# !.python-version
# !src/nexusdl/py.typed
# !src/nexusdl/version.py
# !src/nexusdl/data/sites.yaml
# !src/nexusdl/data/sites_schema.json
# !src/nexusdl/data/default_config.yaml
# !src/nexusdl/data/user_agents.txt
# !src/nexusdl/data/comic_info_template.xml
# !src/nexusdl/data/translations/*.json
# !src/nexusdl/interfaces/web/frontend/pnpm-lock.yaml
#
# Les lignes ci-dessus sont commentées : elles n'ont aucun effet
# aujourd'hui, elles documentent le contrat.  Si une règle d'ignore
# générique vient à matcher l'un de ces fichiers, décommenter la ligne
# correspondante rétablit le versionnement.
