# ════════════════════════════════════════════════════════════════════
# NexusDL — MANIFEST.in
# ════════════════════════════════════════════════════════════════════
#
# ⚠️  Ce fichier n'est PAS lu par le build backend actuel (hatchling).
#     Il est conservé pour documentation des contributeurs et pour un
#     éventuel retour à setuptools.  La source de vérité pour la sdist
#     est [tool.hatch.build.targets.sdist] dans pyproject.toml.
#
# ════════════════════════════════════════════════════════════════════
# NOTES DE SYNTAXE — à respecter pour toute modification future
# ════════════════════════════════════════════════════════════════════
#
#   1. ``prune <dir>`` prend UN SEUL argument.  ``prune .venv venv env``
#      est une erreur silencieuse — ``prune`` ne traite que ``.venv``
#      et ignore le reste.  Chaque dossier nécessite sa propre ligne.
#
#   2. ``prune <glob>`` NE SUPPORTE PAS les globs.  ``prune *.egg-info``
#      ne matche rien.  Il faut ``prune <nom-exact>``.
#
#   3. ``exclude <pattern>`` ne matche qu'à la RACINE de la sdist.
#      Pour exclure un fichier à n'importe quelle profondeur, utiliser
#      ``global-exclude <pattern>``.
#
#   4. ``recursive-exclude . <name>`` matche des FICHIERS, pas des
#      dossiers.  Pour exclure un dossier de cache à n'importe quelle
#      profondeur, utiliser ``global-exclude */<dirname>/*``.
#
#   5. ``recursive-include <dir> <pattern>`` accepte plusieurs patterns
#      sur la même ligne : ``recursive-include src *.py *.pyi``.
#
# ════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────
# 1. FICHIERS RACINE
# ────────────────────────────────────────────────────────────────────
include README.md
include LICENSE
include CHANGELOG.md
include SECURITY.md
include SECURITY_HALL_OF_FAME.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include nexus.dl
include pyproject.toml
include MANIFEST.in

# Fichiers de configuration du dépôt (utiles aux contributeurs qui
# extraient la sdist pour contribuer au projet).
include .env.example
include .editorconfig
include .gitattributes
include .gitignore
include .dockerignore
include .python-version
include .pre-commit-config.yaml

# ────────────────────────────────────────────────────────────────────
# 2. PACKAGE PYTHON — src/nexusdl/
# ────────────────────────────────────────────────────────────────────
# Le code Python est découvert automatiquement par hatchling/setuptools.
# Les règles ci-dessous ne couvrent que les fichiers non-Python
# nécessaires au fonctionnement à l'exécution.

# ── Données runtime (indispensables au fonctionnement) ──
# ``data/translations/*.json`` est déjà couvert par ``*.json`` ci-dessous.
recursive-include src/nexusdl/data *.yaml *.yml *.json *.xml *.txt

# ── Migrations SQL (indispensables au démarrage de la bibliothèque) ──
recursive-include src/nexusdl/core/library/migrations *.sql

# ── Marqueur PEP 561 (typage) ──
include src/nexusdl/py.typed

# ── Exemple de plugin (référence pour la communauté) ──
recursive-include src/nexusdl/plugins/_example *.py *.yaml

# ── Template de parser custom (référence pour la communauté) ──
recursive-include src/nexusdl/parsers/custom *.py

# ── Themes Textual (TUI) ──
recursive-include src/nexusdl/interfaces/cli *.tcss

# ────────────────────────────────────────────────────────────────────
# 3. CONFIGURATION (exemples uniquement, pas les configs réelles)
# ────────────────────────────────────────────────────────────────────
recursive-include config *.example.yaml *.example.yml
include config/logging.yaml

# ────────────────────────────────────────────────────────────────────
# 4. DOCUMENTATION (sources uniquement, pas les builds Sphinx)
# ────────────────────────────────────────────────────────────────────
recursive-include docs/source *.md *.rst *.py *.css *.html *.png *.svg
include docs/API.md
include docs/README.md

# ────────────────────────────────────────────────────────────────────
# 5. SCRIPTS UTILITAIRES
# ────────────────────────────────────────────────────────────────────
recursive-include scripts *.py
include scripts/README.md

# ────────────────────────────────────────────────────────────────────
# 6. DOCKER (référence pour auto-hébergement)
# ────────────────────────────────────────────────────────────────────
include docker/Dockerfile
include docker/Dockerfile.gui
include docker/Dockerfile.web
include docker/docker-compose.yml
include docker/docker-compose.dev.yml
include docker/entrypoint.sh
include docker/entrypoint.ps1
include docker/nginx.conf

# ────────────────────────────────────────────────────────────────────
# 7. GITHUB (templates pour contributeurs et workflows CI)
# ────────────────────────────────────────────────────────────────────
include .github/CODEOWNERS
include .github/dependabot.yml
include .github/PULL_REQUEST_TEMPLATE.md
recursive-include .github/ISSUE_TEMPLATE *.md
recursive-include .github/workflows *.yml

# ────────────────────────────────────────────────────────────────────
# 8. ASSETS LÉGERS (bannière, logo — pas les screenshots)
# ────────────────────────────────────────────────────────────────────
include assets/banner.png
include assets/banner_dark.png
include assets/logo_animated.svg
include assets/icons/nexusdl.svg
include assets/icons/nexusdl.png

# ────────────────────────────────────────────────────────────────────
# 9. TESTS (référence pour contributeurs, sans fixtures lourdes)
# ────────────────────────────────────────────────────────────────────
recursive-include tests *.py
include tests/pytest.ini
include tests/conftest.py

# Fixtures légères (JSON/YAML) uniquement — pas les binaires
recursive-include tests/fixtures *.json *.yaml

# ────────────────────────────────────────────────────────────────────
# 10. BUILD & CI (référence)
# ────────────────────────────────────────────────────────────────────
include Makefile
include justfile
include tox.ini

# ════════════════════════════════════════════════════════════════════
# EXCLUSIONS — ne JAMAIS inclure dans la sdist
# ════════════════════════════════════════════════════════════════════

# ── Secrets ──
exclude .env
exclude .env.*
recursive-exclude . *.key
recursive-exclude . *.keyfile
recursive-exclude . *.pem
recursive-exclude . *.p12
recursive-exclude . *.pfx

# ── Frontend Next.js (distribué séparément) ──
prune src/nexusdl/interfaces/web/frontend/node_modules
prune src/nexusdl/interfaces/web/frontend/.next
prune src/nexusdl/interfaces/web/frontend/out
prune src/nexusdl/interfaces/web/frontend/.turbo
prune src/nexusdl/interfaces/web/frontend/public/screenshots
exclude src/nexusdl/interfaces/web/frontend/.env.local
exclude src/nexusdl/interfaces/web/frontend/.env.*.local
exclude src/nexusdl/interfaces/web/frontend/*.tsbuildinfo
exclude src/nexusdl/interfaces/web/frontend/.eslintcache

# ── Fichiers Python générés ──
global-exclude *.py[cod]
global-exclude *.so
global-exclude *.pyd

# ── Répertoires de cache (n'importe quelle profondeur) ──
# ``recursive-exclude . <dirname>`` matche des fichiers, pas des
# dossiers — la forme ``global-exclude */<dirname>/*`` exclut le contenu
# de chaque dossier de ce nom, rendant le dossier vide, donc absent.
global-exclude */__pycache__/*
global-exclude */.mypy_cache/*
global-exclude */.ruff_cache/*
global-exclude */.pytest_cache/*
global-exclude */.hypothesis/*
global-exclude */.tox/*
global-exclude */.nox/*

# ── Environnements virtuels ──
prune .venv
prune venv
prune env
prune ENV
prune node_modules

# ── Artefacts de build ──
prune build
prune dist
prune .eggs
prune nexusdl.egg-info
global-exclude *.egg
global-exclude *.whl

# ── Données runtime NexusDL ──
prune data
prune downloads
prune temp
prune tmp
prune logs
prune .cache
prune .nexusdl
exclude library.db
exclude library.db-*
exclude cookies.enc
recursive-exclude . *.sqlite
recursive-exclude . *.sqlite3
recursive-exclude . *.log

# ── Screenshots (trop lourds) ──
prune assets/screenshots

# ── IDE / éditeurs ──
prune .idea
prune .vscode
prune .settings
recursive-exclude . *.iml
recursive-exclude . *.swp
recursive-exclude . *.swo
recursive-exclude . *~

# ── OS ──
global-exclude .DS_Store
global-exclude ._*
global-exclude .Spotlight-V100
global-exclude .Trashes
global-exclude Thumbs.db
global-exclude desktop.ini
global-exclude Icon?

# ── Divers ──
recursive-exclude . *.tmp
recursive-exclude . *.bak
recursive-exclude . *.orig
recursive-exclude . *.rej
prune .git
