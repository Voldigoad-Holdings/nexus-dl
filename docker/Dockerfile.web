# syntax=docker/dockerfile:1.7-labs
# ════════════════════════════════════════════════════════════════════
# NexusDL — Web Dockerfile (FastAPI + Next.js + Nginx)
#
# Fichier : docker/Dockerfile.web
#
# Image    : ghcr.io/voldigoad-holdings/nexus-dl-web
# Build    : docker buildx build --platform linux/amd64,linux/arm64 \
#              -f docker/Dockerfile.web -t nexusdl-web .
#
# Contenu  : Python 3.12 + NexusDL[cli,web] + Node.js 20 + Next.js
#            (build standalone) + Nginx (reverse proxy)
#
# Architecture (une seule image, 3 process) :
#   ┌──────────────────────────────────────────────────────┐
#   │  Nginx :8080 (reverse proxy)                         │
#   │    ├── /api/*      → FastAPI (uvicorn) :8000         │
#   │    ├── /ws/*       → FastAPI (websocket) :8000       │
#   │    └── /*          → Next.js :3000                   │
#   ├──────────────────────────────────────────────────────┤
#   │  FastAPI :8000 (uvicorn, 2 workers)                  │
#   ├──────────────────────────────────────────────────────┤
#   │  Next.js :3000 (node server.js, standalone)          │
#   └──────────────────────────────────────────────────────┘
#
# Ports    : 8080 (HTTP, reverse proxy)
# Volumes  : /config, /data, /downloads
#
# ⚠️  Image non-root (UID 1000, GID 1000).
# ⚠️  Nginx écoute sur 8080 (pas 80) pour tourner en non-root.
# ⚠️  tini est PID 1 (reap zombies, forward SIGTERM/SIGQUIT).
# ════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────
# ARGs
# ────────────────────────────────────────────────────────────────────
ARG PYTHON_VERSION=3.12
ARG NODE_VERSION=20
ARG DEBIAN_VERSION=bookworm
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=0.1.0

# URLs publiques (injectées au build Next.js)
ARG NEXT_PUBLIC_API_URL=http://localhost:8080
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8080
ARG NEXT_PUBLIC_APP_NAME=NexusDL

# ────────────────────────────────────────────────────────────────────
# STAGE 1 — frontend-builder (Next.js)
# ────────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-bookworm-slim AS frontend-builder

# Empêche Next.js de collecter la télémétrie
ENV NEXT_TELEMETRY_DISABLED=1 \
    CI=true \
    NODE_ENV=production

# Installer pnpm (plus rapide et déterministe que npm)
RUN corepack enable \
 && corepack prepare pnpm@9.12.0 --activate \
 && pnpm --version

WORKDIR /build

# Copier les fichiers de dépendances (cache optimal)
COPY src/nexusdl/interfaces/web/frontend/package.json ./
COPY src/nexusdl/interfaces/web/frontend/pnpm-lock.yaml ./

# Installer les dépendances (frozen lockfile = reproductible)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Copier le reste du frontend
COPY src/nexusdl/interfaces/web/frontend/ ./

# Variables d'env pour le build (injectées dans les bundles Next.js)
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL} \
    NEXT_PUBLIC_APP_NAME=${NEXT_PUBLIC_APP_NAME}

# Build standalone (produit .next/standalone + .next/static)
RUN pnpm build

# Vérifier que le build a produit un standalone
RUN test -f .next/standalone/server.js || \
    (echo "ERROR: Next.js standalone build failed. Check 'output: standalone' in next.config.js." && exit 1)

# ────────────────────────────────────────────────────────────────────
# STAGE 2 — backend-builder (Python)
# ────────────────────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim-${DEBIAN_VERSION} AS backend-builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=120

# Dépendances de compilation
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential \
        libffi-dev \
        libssl-dev \
        pkg-config \
 && rm -rf /var/lib/apt/lists/*

# Venv isolé
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip + uv
RUN pip install --upgrade pip \
 && pip install "uv>=0.4,<1.0"

# Dépendances Python (cache optimal)
WORKDIR /build
COPY pyproject.toml uv.lock README.md LICENSE ./

# Install CLI + Web extras
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /opt/venv/bin/python \
        -e ".[cli,web]"

# Code source
COPY src/ ./src/
COPY config/ ./config/

# Reinstall editable
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /opt/venv/bin/python \
        --no-deps -e .

# Vérifier que FastAPI est importable
RUN /opt/venv/bin/python -c "from nexusdl.interfaces.web.backend.main import app; print('FastAPI OK')"

# ────────────────────────────────────────────────────────────────────
# STAGE 3 — runtime (Nginx + FastAPI + Next.js)
# ────────────────────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim-${DEBIAN_VERSION} AS runtime

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION

# ────────────────────────────────────────────────────────────────────
# Labels OCI
# ────────────────────────────────────────────────────────────────────
LABEL org.opencontainers.image.title="NexusDL Web" \
      org.opencontainers.image.description="NexusDL web app (FastAPI + Next.js + Nginx)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/Voldigoad-Holdings/nexus-dl" \
      org.opencontainers.image.url="https://github.com/Voldigoad-Holdings/nexus-dl" \
      org.opencontainers.image.documentation="https://github.com/Voldigoad-Holdings/nexus-dl/tree/main/docs" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.authors="Voldigoad-Holdings <drxenon487@gmail.com>" \
      org.opencontainers.image.vendor="Voldigoad-Holdings"

# ────────────────────────────────────────────────────────────────────
# Variables d'environnement
# ────────────────────────────────────────────────────────────────────
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/opt/venv/bin:$PATH" \
    # Node (pour Next.js standalone)
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=127.0.0.1 \
    # Chemins NexusDL
    NEXUSDL_CONFIG_DIR=/config \
    NEXUSDL_DATA_DIR=/data \
    NEXUSDL_LOGS_DIR=/data/logs \
    NEXUSDL_DOWNLOAD_DIR=/downloads \
    NEXUSDL_TEMP_DIR=/tmp/nexusdl \
    NEXUSDL_LIBRARY_DB_PATH=/data/library.db \
    NEXUSDL_COOKIE_STORAGE_PATH=/data/cookies.enc \
    # Environnement
    NEXUSDL_APP_ENVIRONMENT=prod \
    NEXUSDL_LOG_FORMAT=json \
    NEXUSDL_LOG_LEVEL=INFO \
    # Uvicorn
    UVICORN_HOST=127.0.0.1 \
    UVICORN_PORT=8000 \
    UVICORN_WORKERS=2

# ────────────────────────────────────────────────────────────────────
# Dépendances système runtime
# ────────────────────────────────────────────────────────────────────
# - nginx       : reverse proxy
# - curl        : healthcheck
# - tini        : PID 1
# - supervisor  : gère les 3 process (nginx, uvicorn, node)
# - nodejs      : runtime Next.js standalone
# - ca-certs, tzdata
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        nginx \
        nodejs \
        curl \
        tini \
        supervisor \
        ca-certificates \
        tzdata \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# ────────────────────────────────────────────────────────────────────
# Utilisateur non-root
# ────────────────────────────────────────────────────────────────────
ARG UID=1000
ARG GID=1000

RUN groupadd --gid "${GID}" nexusdl \
 && useradd --uid "${UID}" --gid "${GID}" \
            --shell /bin/bash \
            --create-home \
            --home-dir /home/nexusdl \
            nexusdl

# ────────────────────────────────────────────────────────────────────
# Répertoires
# ────────────────────────────────────────────────────────────────────
RUN mkdir -p \
        /app \
        /config \
        /data \
        /downloads \
        /tmp/nexusdl \
        /var/log/nginx \
        /var/lib/nginx \
        /run/nginx \
        /var/run \
 && chown -R nexusdl:nexusdl \
        /app /config /data /downloads /tmp/nexusdl \
        /var/log/nginx /var/lib/nginx /run/nginx \
 && chmod 755 /app /config /data /downloads \
 && chmod 1777 /tmp

WORKDIR /app

# ────────────────────────────────────────────────────────────────────
# Copie backend (venv + code)
# ────────────────────────────────────────────────────────────────────
COPY --from=backend-builder --chown=nexusdl:nexusdl /opt/venv /opt/venv
COPY --from=backend-builder --chown=nexusdl:nexusdl /build/src /app/src
COPY --from=backend-builder --chown=nexusdl:nexusdl /build/config /app/config

# ────────────────────────────────────────────────────────────────────
# Copie frontend (Next.js standalone)
# ────────────────────────────────────────────────────────────────────
# Le standalone contient uniquement les fichiers nécessaires :
#   - server.js
#   - node_modules minimales
#   - package.json
# + les assets statiques (copiés séparément)
COPY --from=frontend-builder --chown=nexusdl:nexusdl \
    /build/.next/standalone /app/frontend
COPY --from=frontend-builder --chown=nexusdl:nexusdl \
    /build/.next/static /app/frontend/.next/static
COPY --from=frontend-builder --chown=nexusdl:nexusdl \
    /build/public /app/frontend/public

# ────────────────────────────────────────────────────────────────────
# Configuration Nginx
# ────────────────────────────────────────────────────────────────────
COPY --chown=nexusdl:nexusdl docker/nginx.conf /etc/nginx/nginx.conf
COPY --chown=nexusdl:nexusdl docker/nginx.conf /etc/nginx/conf.d/default.conf

# ────────────────────────────────────────────────────────────────────
# Configuration Supervisor (gère les 3 process)
# ────────────────────────────────────────────────────────────────────
COPY --chown=nexusdl:nexusdl docker/supervisord.conf /etc/supervisor/conf.d/nexusdl.conf
COPY --chown=nexusdl:nexusdl docker/supervisord.conf /etc/supervisor/supervisord.conf

# ────────────────────────────────────────────────────────────────────
# Entrypoint
# ────────────────────────────────────────────────────────────────────
COPY --chown=nexusdl:nexusdl docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# ────────────────────────────────────────────────────────────────────
# Healthcheck (HTTP sur le reverse proxy)
# ────────────────────────────────────────────────────────────────────
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -sf http://127.0.0.1:8080/api/v1/health || exit 1

# ────────────────────────────────────────────────────────────────────
# Entrypoint + commande
# ────────────────────────────────────────────────────────────────────
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf", "-n"]

# Signal d'arrêt (SIGQUIT pour Nginx graceful, SIGTERM pour les autres)
STOPSIGNAL SIGTERM

# ────────────────────────────────────────────────────────────────────
# Utilisateur final
# ────────────────────────────────────────────────────────────────────
USER nexusdl:nexusdl

# ────────────────────────────────────────────────────────────────────
# Ports
# ────────────────────────────────────────────────────────────────────
EXPOSE 8080
