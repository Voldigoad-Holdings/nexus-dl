{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Voldigoad-Holdings/nexus-dl/blob/main/src/nexusdl/data/sites_schema.json",
  "title": "NexusDL Sites Configuration",
  "description": "Schema for validating sites.yaml. See ADR-002 (no CBR) and ADR-004 (no secrets, HTTPS only).",
  "type": "object",
  "additionalProperties": false,
  "required": ["sites"],
  "properties": {
    "config_version": {
      "type": "integer",
      "const": 1,
      "description": "Format version for future migrations."
    },
    "sites": {
      "type": "array",
      "description": "List of supported sites.",
      "minItems": 1,
      "items": { "$ref": "#/$defs/site" }
    },
    "aliases": {
      "type": "object",
      "description": "Short aliases pointing to site IDs (e.g. 'md' → 'mangadex').",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$",
        "minLength": 1,
        "maxLength": 50
      }
    },
    "categories": {
      "type": "object",
      "description": "Per-category grouping of site IDs (fr, en, kr, adult).",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "uniqueItems": true
      }
    },
    "disabled_sites": {
      "type": "array",
      "description": "Sites to disable (removed from registry). Accepts both a bare site id and an object with an id and an optional human-readable reason.",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "minLength": 1,
            "maxLength": 50
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$",
                "minLength": 1,
                "maxLength": 50
              },
              "reason": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        ]
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "domains",
        "parser_class",
        "language",
        "adult",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique site ID (snake_case, matches parser.site_id).",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "minLength": 1,
          "maxLength": 50,
          "examples": ["mangadex", "sushiscan", "nhentai", "asura_scans"]
        },
        "name": {
          "type": "string",
          "description": "Human-readable site name.",
          "minLength": 1,
          "maxLength": 100,
          "examples": ["MangaDex", "SushiScan", "nhentai"]
        },
        "domains": {
          "type": "array",
          "description": "List of HTTPS domains. First is primary.",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[a-zA-Z0-9.-]+(:[0-9]+)?(/.*)?$",
            "maxLength": 2000,
            "examples": ["https://mangadex.org", "https://api.mangadex.org"]
          }
        },
        "parser_class": {
          "type": "string",
          "description": "Format 'module:Class' (importable via importlib).",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[A-Z][a-zA-Z0-9_]*$",
          "minLength": 10,
          "maxLength": 200,
          "examples": [
            "nexusdl.parsers.en.mangadex:MangaDexParser",
            "nexusdl.parsers.fr.sushiscan:SushiScanParser"
          ]
        },
        "language": {
          "type": "string",
          "description": "Primary language, matching Language in core/models/enums.py.",
          "enum": ["fr", "en", "ja", "ko", "zh", "es", "pt", "it", "de", "ru", "ar", "unknown"]
        },
        "adult": {
          "type": "boolean",
          "description": "Site hosts adult content (18+). Filtered by NEXUSDL_CONTENT__ALLOW_ADULT."
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "default_headers": {
          "type": "object",
          "description": "Default HTTP headers (no Cookie, no Authorization).",
          "additionalProperties": {
            "type": "string",
            "maxLength": 1000
          },
          "propertyNames": {
            "not": { "enum": ["Cookie", "Authorization", "Proxy-Authorization"] }
          }
        },
        "cookies_required": {
          "type": "array",
          "description": "Cookie NAMES required (values live in .env).",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "maxLength": 100
          },
          "uniqueItems": true,
          "examples": [["cf_clearance", "cf_bm"]]
        },
        "max_concurrent_downloads": {
          "type": "integer",
          "description": "Per-site cap on concurrent chapter downloads.",
          "minimum": 1,
          "maximum": 32,
          "default": 4
        },
        "rate_limit": {
          "type": "number",
          "description": "Per-site request rate, in requests per second.",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "default": 2.0
        },
        "_comment": {
          "type": "string",
          "description": "Free-form comment (ignored by parsers).",
          "maxLength": 500
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "The nine capability flags, matching SiteCapabilities in core/models/site.py.",
      "additionalProperties": false,
      "required": [
        "search",
        "pagination",
        "filters",
        "metadata",
        "cover_art",
        "chapter_list",
        "reader_images",
        "cloudflare",
        "js_rendered"
      ],
      "properties": {
        "search": {
          "type": "boolean",
          "default": true,
          "description": "Text search is supported."
        },
        "pagination": {
          "type": "boolean",
          "default": true,
          "description": "Search results are paginated."
        },
        "filters": {
          "type": "boolean",
          "default": false,
          "description": "Advanced search filters are supported."
        },
        "metadata": {
          "type": "boolean",
          "default": false,
          "description": "Rich metadata (authors, description, year, status) is available."
        },
        "cover_art": {
          "type": "boolean",
          "default": true,
          "description": "Cover image URLs are extracted."
        },
        "chapter_list": {
          "type": "boolean",
          "default": true,
          "description": "The complete chapter list is enumerable."
        },
        "reader_images": {
          "type": "boolean",
          "default": true,
          "description": "The complete reader image list is enumerable."
        },
        "cloudflare": {
          "type": "boolean",
          "default": false,
          "description": "The site is behind Cloudflare (parser inherits CloudflareMixin)."
        },
        "js_rendered": {
          "type": "boolean",
          "default": false,
          "description": "The site requires JavaScript rendering (parser inherits JsRenderedMixin)."
        }
      }
    }
  },
  "examples": [
    {
      "config_version": 1,
      "sites": [
        {
          "id": "mangadex",
          "name": "MangaDex",
          "domains": ["https://mangadex.org"],
          "parser_class": "nexusdl.parsers.en.mangadex:MangaDexParser",
          "language": "en",
          "adult": false,
          "capabilities": {
            "search": true,
            "pagination": true,
            "filters": true,
            "metadata": true,
            "cover_art": true,
            "chapter_list": true,
            "reader_images": true,
            "cloudflare": false,
            "js_rendered": false
          },
          "default_headers": {},
          "cookies_required": [],
          "max_concurrent_downloads": 4,
          "rate_limit": 4.0
        }
      ],
      "aliases": { "md": "mangadex" },
      "categories": {
        "fr": ["sushiscan", "scan_manga"],
        "en": ["mangadex", "comick"],
        "kr": ["manhwa_raw", "manhwaclub"],
        "adult": ["nhentai", "hentaizone"]
      },
      "disabled_sites": [
        "batoto",
        { "id": "reaperscans", "reason": "Shut down May 2025" }
      ]
    }
  ]
}
